# Choose ONE provider: "openai" or "ollama"
LLM_PROVIDER=ollama

# --- Used when LLM_PROVIDER=openai ---
# Works for real OpenAI, or any OpenAI-compatible endpoint (Groq, Grok/xAI, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Used when LLM_PROVIDER=ollama (free, runs locally, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
